{
  "version": 2,
  "rewrites": [
    {
      "source": "/raw/(.*)",
      "destination": "https://raw.githubusercontent.com/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "https://github.githubassets.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "https://github.com/$1"
    }
  ]
}